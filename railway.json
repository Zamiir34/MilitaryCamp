{
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "npm start"
  },
  "services": [
    {
      "name": "backend",
      "source": {
        "root": "backend"
      },
      "build": {
        "builder": "NIXPACKS"
      },
      "deploy": {
        "startCommand": "npm start"
      },
      "healthcheckPath": "/api/dashboard"
    },
    {
      "name": "frontend",
      "source": {
        "root": "frontend"
      },
      "build": {
        "builder": "NIXPACKS"
      },
      "deploy": {
        "startCommand": "npm run build && npm run preview"
      }
    }
  ]
}